<Window
    x:Class="BitSpringVideo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The picture fills the window; the controls are pieces of acrylic floating over it:
           top left      the file's name; opens another file. Beside it, where the file
                         stands in its folder or playlist; opens the list
           top right     settings, and the signal lens with its panel
           bottom        transport: previous, play, next, time, seek, volume, tracks, full screen
         Panels and menus are built in MainWindow.xaml.cs, where their content comes from. -->
    <Grid
        x:Name="Root"
        Background="Black"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        PointerMoved="OnPointerMoved"
        DoubleTapped="OnDoubleTapped"
        KeyboardAcceleratorPlacementMode="Hidden">

        <Grid.Resources>
            <!-- A button that is only its glyph or words, on the glass. -->
            <Style x:Key="OnGlass" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource PorcelainBrush}" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <!-- Keys belong to the player (space pauses, arrows seek), not to whichever
                     button was clicked last. -->
                <Setter Property="IsTabStop" Value="False" />
            </Style>
        </Grid.Resources>

        <SwapChainPanel x:Name="Video" />

        <!-- Nothing open -->
        <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="480">
            <TextBlock
                x:Name="EmptyTitle"
                FontSize="30"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Foreground="{StaticResource PorcelainBrush}" />
            <TextBlock
                x:Name="EmptyHint"
                FontSize="14"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Foreground="{StaticResource QuietBrush}" />
            <TextBlock
                x:Name="EmptyDisplay"
                FontSize="14"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Foreground="{StaticResource QuietBrush}" />
            <TextBlock
                x:Name="EmptyError"
                FontSize="13"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="Collapsed"
                Foreground="{StaticResource AlarmBrush}" />
            <Button
                x:Name="OpenButton"
                Click="OnOpenClick"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Padding="20,8"
                CornerRadius="19"
                IsTabStop="False" />
        </StackPanel>

        <!-- The strip the window is dragged by. The system draws its own buttons at its right end. -->
        <Grid x:Name="DragRegion" Height="32" VerticalAlignment="Top" Background="Transparent" />

        <!-- Settings stay within reach when nothing is open. -->
        <Border
            x:Name="SettingsPill"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,40,20,0"
            Width="36"
            Height="36"
            CornerRadius="18"
            Background="{StaticResource GlassBrush}">
            <Button x:Name="SettingsButton" Style="{StaticResource OnGlass}" HorizontalAlignment="Center" Padding="8">
                <FontIcon Glyph="&#xE713;" FontSize="15" />
            </Button>
        </Border>

        <!-- The film was picked up where it was left: said for a moment, with its beginning on offer.
             Just above the transport bar, whether or not that shows. -->
        <Border
            x:Name="ResumeNote"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,90"
            Height="38"
            Padding="16,0,6,0"
            CornerRadius="19"
            Background="{StaticResource GlassBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="ResumeText" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource QuietBrush}" />
                <Button x:Name="RestartButton" Click="OnRestartClick" FontSize="13" Padding="12,3,12,4" CornerRadius="13" IsTabStop="False" />
            </StackPanel>
        </Border>

        <!-- A small picture of the moment under the pointer, over the seek bar. -->
        <StackPanel
            x:Name="PreviewPane"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Spacing="6"
            IsHitTestVisible="False">
            <Border CornerRadius="10" BorderThickness="1" BorderBrush="#38E8EDEA" Width="176">
                <Image x:Name="PreviewImage" Stretch="Uniform" />
            </Border>
            <Border HorizontalAlignment="Center" Height="26" Padding="10,0" CornerRadius="13" Background="{StaticResource GlassBrush}">
                <TextBlock x:Name="PreviewTime" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource PorcelainBrush}" />
            </Border>
        </StackPanel>

        <!-- What a key just changed, said for a moment in the same place. -->
        <Border
            x:Name="KeyNote"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,90"
            Height="38"
            Padding="16,0,16,0"
            CornerRadius="19"
            IsHitTestVisible="False"
            Background="{StaticResource GlassBrush}">
            <TextBlock x:Name="KeyNoteText" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource PorcelainBrush}" />
        </Border>

        <Grid x:Name="Chrome" Visibility="Collapsed">
            <!-- What is playing, and where it stands among the others: "2 / 10" opens the list. -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,40,0,0">
                <Border
                    x:Name="TitlePill"
                    Height="36"
                    CornerRadius="18"
                    Background="{StaticResource GlassBrush}">
                    <Button x:Name="TitleButton" Style="{StaticResource OnGlass}" Click="OnOpenClick" Padding="14,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            <TextBlock x:Name="TitleText" FontSize="13" MaxWidth="380" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </Border>
                <Border
                    x:Name="QueuePill"
                    Height="36"
                    MinWidth="36"
                    CornerRadius="18"
                    Background="{StaticResource GlassBrush}">
                    <Button x:Name="QueueButton" Style="{StaticResource OnGlass}" HorizontalAlignment="Center" Padding="12,6">
                        <Grid>
                            <FontIcon x:Name="QueueGlyph" Glyph="&#xE8FD;" FontSize="14" />
                            <TextBlock x:Name="QueueText" FontSize="14" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </Border>
            </StackPanel>

            <Border
                x:Name="SignalPill"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,40,66,0"
                Height="36"
                CornerRadius="18"
                Visibility="Collapsed"
                Background="{StaticResource GlassBrush}">
                <Button x:Name="SignalButton" Style="{StaticResource OnGlass}" Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="SignalDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="SignalFormat" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="SignalTreatment" FontSize="13" Foreground="{StaticResource QuietBrush}" />
                    </StackPanel>
                </Button>
            </Border>

            <Border
                x:Name="Transport"
                VerticalAlignment="Bottom"
                MaxWidth="820"
                Height="56"
                Margin="24,0,24,22"
                Padding="9,0,10,0"
                CornerRadius="28"
                Background="{StaticResource GlassBrush}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- To the file before this one in the folder or the playlist, and the one after:
                         there when there is more than one. -->
                    <Button x:Name="PreviousButton" Grid.Column="0" Style="{StaticResource OnGlass}" Click="OnPreviousClick" Padding="6" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE892;" FontSize="14" />
                    </Button>
                    <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource OnGlass}" Click="OnNextClick" Padding="6" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE893;" FontSize="14" />
                    </Button>

                    <!-- The one filled shape in the interface: the key takes the signal's colour. -->
                    <Button
                        x:Name="PlayButton"
                        Grid.Column="1"
                        Click="OnPlayClick"
                        Width="38"
                        Height="38"
                        Padding="0"
                        CornerRadius="19"
                        BorderThickness="0"
                        IsTabStop="False"
                        VerticalAlignment="Center">
                        <FontIcon x:Name="PlayGlyph" Glyph="&#xE769;" FontSize="15" />
                    </Button>
                    <TextBlock
                        x:Name="Elapsed"
                        Grid.Column="3"
                        MinWidth="44"
                        FontSize="15"
                        TextAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0"
                        Foreground="{StaticResource PorcelainBrush}" />
                    <Grid Grid.Column="4" Margin="4,0,4,0" VerticalAlignment="Center">
                        <Slider
                            x:Name="Seek"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.001"
                            SmallChange="0.001"
                            VerticalAlignment="Center"
                            IsTabStop="False"
                            ValueChanged="OnSeekChanged" />
                        <!-- Where each chapter begins: a cut through the track, in the glass's own colour. -->
                        <Canvas
                            x:Name="ChapterMarks"
                            IsHitTestVisible="False"
                            VerticalAlignment="Center"
                            Height="6" />
                    </Grid>
                    <Button x:Name="DurationButton" Grid.Column="5" Style="{StaticResource OnGlass}" Click="OnDurationClick" Padding="4,6">
                        <TextBlock x:Name="DurationText" MinWidth="44" FontSize="15" Foreground="{StaticResource QuietBrush}" />
                    </Button>
                    <!-- The speed, as a figure beside the times: quiet at 1×, bright at any other. -->
                    <Button x:Name="SpeedButton" Grid.Column="6" Style="{StaticResource OnGlass}" Padding="2,6" Margin="-6,0,0,0">
                        <TextBlock x:Name="SpeedText" FontSize="15" Text="1×" />
                    </Button>
                    <Button x:Name="MuteButton" Grid.Column="7" Style="{StaticResource OnGlass}" Click="OnMuteClick">
                        <FontIcon x:Name="MuteGlyph" Glyph="&#xE767;" FontSize="15" />
                    </Button>
                    <Slider
                        x:Name="Volume"
                        Grid.Column="8"
                        Width="72"
                        Minimum="0"
                        Maximum="1"
                        StepFrequency="0.01"
                        VerticalAlignment="Center"
                        IsTabStop="False"
                        IsThumbToolTipEnabled="False"
                        ValueChanged="OnVolumeChanged" />
                    <!-- A bar in three parts, as the seek bar is cut into chapters. -->
                    <Button x:Name="ChaptersButton" Grid.Column="9" Style="{StaticResource OnGlass}" Visibility="Collapsed">
                        <Border Width="18" Height="12" BorderThickness="1.5" CornerRadius="3" BorderBrush="{StaticResource PorcelainBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.5" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="1" Fill="{StaticResource PorcelainBrush}" />
                                <Rectangle Grid.Column="3" Fill="{StaticResource PorcelainBrush}" />
                            </Grid>
                        </Border>
                    </Button>
                    <Button x:Name="SubtitlesButton" Grid.Column="10" Style="{StaticResource OnGlass}">
                        <FontIcon x:Name="SubtitlesGlyph" Glyph="&#xE7F0;" FontSize="15" />
                    </Button>
                    <Button x:Name="SoundButton" Grid.Column="11" Style="{StaticResource OnGlass}">
                        <FontIcon Glyph="&#xE8D6;" FontSize="15" />
                    </Button>
                    <!-- How the picture sits in the window, and a frame of it to keep. -->
                    <Button x:Name="PictureButton" Grid.Column="12" Style="{StaticResource OnGlass}">
                        <FontIcon Glyph="&#xE9A6;" FontSize="15" />
                    </Button>
                    <Button x:Name="FullscreenButton" Grid.Column="13" Style="{StaticResource OnGlass}" Click="OnFullscreenClick">
                        <FontIcon x:Name="FullscreenGlyph" Glyph="&#xE740;" FontSize="14" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
